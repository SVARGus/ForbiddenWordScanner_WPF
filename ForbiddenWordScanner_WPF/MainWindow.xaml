<Window x:Class="ForbiddenWordScanner_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForbiddenWordScanner_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <StackPanel>
            <TextBox x:Name="ForbiddenWordTextBox" Margin="5" FontSize="20"/>
            <Button x:Name="SelectForbiddenWordButton" Content="Выберите файл со списком плохих слов" 
                    Click="SelectForbiddenWordButton_Click" Margin="5, 5, 5, 15" FontSize="20" HorizontalAlignment="Center"/>
            
            <TextBox x:Name="SearchDerictoryPath" Margin="5" FontSize="20"/>
            <Button x:Name="SelectSearchDerictoryPath" Content="Выберите дерикторию поиска" 
                    Click="SelectDirectoryPathButton_Click" Margin="5, 5, 5, 15" FontSize="20" HorizontalAlignment="Center"/>
            
            <TextBox x:Name="DirectoryOutPath" Margin="5" FontSize="20"/>
            <Button x:Name="SelectDirectoryOutPathButton" Content="Выберите папку сохранения" 
                    Click="SelectDirectoryOutPathButton_Click" Margin="5, 5, 5, 15" FontSize="20" HorizontalAlignment="Center" />
            
            <ProgressBar x:Name="SearchProgresBar" Height="20" Margin="5" Minimum="0" Maximum="100"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="StartButton" Content="Start" Margin="10" FontSize="24" Click="StartButton_Click"/>
                <Button Grid.Column="1" x:Name="PauseButton" Content="Pause" Margin="10" FontSize="24" Click="PauseButton_Click"/>
                <Button Grid.Column="2" x:Name="ResumeButton" Content="Resume" Margin="10" FontSize="24" Click="ResumeButton_Click"/>
                <Button Grid.Column="3" x:Name="StopButton" Content="Stop" Margin="10" FontSize="24" Click="StopButton_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
